{
    "name": "ilbronza/accountmanager",
    "description": "User accounts, roles, profiles and access controls for Laravel applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://www.sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/accountmanager",
    "keywords": [
        "Laravel",
        "AccountManager"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0",
        "laravel/ui": "^4.0",
        "laravel/socialite": "^5.0",
        "ilbronza/crud": "^2.5",
        "ilbronza/form": "^2.5",
        "ilbronza/formfield": "^2.5",
        "ilbronza/datatables": "^2.5",
        "ilbronza/buttons": "^2.5",
        "ilbronza/menu": "^2.5",
        "ilbronza/uikittemplate": "^2.5",
        "ilbronza/ukn": "^2.5",
        "ilbronza/addresses": "^2.5",
        "ilbronza/notifications": "^2.5",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-activitylog": "^4.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\AccountManager\\": "src/",
            "IlBronza\\AccountManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\AccountManager\\Tests\\": "tests",
            "App\\": "tests/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\AccountManager\\AccountManagerServiceProvider"
            ],
            "aliases": {
                "AccountManager": "IlBronza\\AccountManager\\Facades\\AccountManager"
            }
        },
        "branch-alias": {
            "dev-master": "2.5.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:lint": "@php tests/lint.php"
    }
}
