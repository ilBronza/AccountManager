{
    "name": "ilbronza/accountmanager",
    "description": "User accounts, roles, profiles and access controls for Laravel applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://www.sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/accountmanager",
    "keywords": [
        "Laravel",
        "AccountManager"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^9.52.21 || >=10.48",
        "laravel/ui": ">=4.0",
        "ilbronza/crud": "*",
        "ilbronza/form": "*",
        "ilbronza/formfield": "*",
        "ilbronza/datatables": "*",
        "ilbronza/buttons": "*",
        "ilbronza/menu": "*",
        "ilbronza/uikittemplate": "*",
        "ilbronza/ukn": "*",
        "spatie/laravel-permission": ">=5.11",
        "spatie/laravel-medialibrary": ">=10.13",
        "spatie/laravel-activitylog": ">=4.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": ">=8.0",
        "phpunit/phpunit": ">=10.5",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "laravel/socialite": ">=5.0",
        "directorytree/ldaprecord-laravel": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\AccountManager\\": "src/",
            "IlBronza\\AccountManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\AccountManager\\Tests\\": "tests",
            "App\\": "tests/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\AccountManager\\AccountManagerServiceProvider"
            ],
            "aliases": {
                "AccountManager": "IlBronza\\AccountManager\\Facades\\AccountManager"
            }
        },
        "branch-alias": {
            "dev-master": "2.5.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:lint": "@php tests/lint.php"
    },
    "suggest": {
        "ilbronza/notifications": "Enables extended database notifications for roles.",
        "ilbronza/addresses": "Enables address management and birthplace lookup.",
        "laravel/socialite": "Enables GitHub authentication.",
        "directorytree/ldaprecord-laravel": "^3.4: Enables optional Active Directory login (requires ext-ldap)."
    }
}
